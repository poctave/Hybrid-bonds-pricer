from IPython.display import HTML, display
import base64
import os

def create_download_link(filename):
    """Create a download link for a file"""
    with open(filename, "rb") as f:
        data = f.read()
    b64 = base64.b64encode(data).decode()
    href = f'<a href="data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{b64}" download="{os.path.basename(filename)}">Download {os.path.basename(filename)}</a>'
    return href

