def get_data_for_date(date_str):

    req1 = bql.Request(univ1, fields1, with_params={'dates': date_str, 'fill':'prev'})
    res1 = bq.execute(req1)
    df_reg1 = pd.concat([r1.df() for r1 in res1], axis=1)
    
    req2 = bql.Request(univ2, fields2, with_params={'dates': date_str, 'fill':'prev'})
    res2 = bq.execute(req2)
    df_reg2 = pd.concat([r2.df() for r2 in res2], axis=1)
    
    z_spread_perp_list = []
    z_spread_senior_list = []
    sss_list = []
    bond_names = []
    
    for i in range(len(results_df2)):
        z_spread_perp = df_reg2["SPREAD(spread_type='Z')"].iloc[i]
        z_spread_senior = df_reg1[f"regression_{i}"].iloc[0]  # Use the unique regression field
        sss = z_spread_perp - z_spread_senior
        
        z_spread_perp_list.append(z_spread_perp)
        z_spread_senior_list.append(z_spread_senior)
        sss_list.append(sss)
        bond_names.append(results_df2["NAME"].iloc[i])
    
    # Create the final dataframe
    df_final = pd.DataFrame({
        'bond_name': bond_names,
        'z-spread perp': z_spread_perp_list,
        'z-spread senior': z_spread_senior_list,
        'SSS': sss_list,
    })

    df_final['date'] = date_str
    
    return df_final
