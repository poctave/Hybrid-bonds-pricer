def NSS(x, β0, β1, β2, β3, λ0, λ1):
    term1 = (1 - np.exp(-x / λ0)) / (x / λ0)
    term2 = term1 - np.exp(-x / λ0)
    term3 = (1 - np.exp(-x / λ1)) / (x / λ1) - np.exp(-x / λ1)
    return β0 + β1 * term1 + β2 * term2 + β3 * term3

