def get_data(list_tickers, regression_type_choose='nelson_siegel_svenson', Min_Amt_out_choose=200, Max_Amt_out_choose=3000, Min_Maturity_choose=0.5, Max_Maturity_choose=80):

    """Retrieves data from BQL for the selected tickers."""

    ticker_to_sector = {
        bloomberg_ticker: sector
        for _, (bloomberg_ticker, sector) in tickers_mapping.items()
    }

    zspread = bq.data.spread(spread_type='Z')
    moody = bq.data.rating(rating_source='moody')

    data_items = {
        'Name' : bq.data.name(),
        'Company Name': bq.data.long_comp_name(),
        'Equity Ticker' : bq.data.cast_parent_equity_ticker(),
        'Z-Spread': zspread,
        'Moody Rating': moody['BASE_RATING'],
        'mdy_rating_scale': moody['NORMALIZED_SCALE'],
        'S&P Rating': bq.data.rating(rating_source='sp')['BASE_RATING'],
        'Fitch Rating': bq.data.rating(rating_source='fitch')['BASE_RATING'],

        'Amount Outstanding': bq.data.amt_outstanding(),
        'Next Call Date' : bq.data.nxt_call_dt(),
        'Δ Z-spread 1w': zspread - bq.data.spread(spread_type='Z', dates='-1w', fill='prev'),
    }

    # Build and execute the request
    universe = (
        bq.univ.bonds(list_tickers)
        .filter(
            (bq.data.crncy() == "eur")
            .and_(bq.data.hybrid() == 'true')
            .and_(bq.data.amt_outstanding()/1000000 > Min_Amt_out_choose)
            .and_(bq.data.amt_outstanding()/1000000 < Max_Amt_out_choose)
        )
    )

    request = bql.Request(universe, data_items)
    response = bq.execute(request)

    results_df = pd.concat(
        [data_item.df()[data_item.name] for data_item in response],
        axis=1
    )


    results_df['Next Call Date (years)'] = (results_df["Next Call Date"] - pd.Timestamp.today()).dt.days / 365.25
    results_df['Amount Outstanding'] = (results_df['Amount Outstanding']/ 1000)

    results_df['Sector'] = results_df['Equity Ticker'].map(ticker_to_sector).fillna('Unknown')

    ###################################

    # Group by equity ticker to reduce the number of bql regression requests
    grouped = results_df.groupby('Equity Ticker')
    all_regression_results = {}

    for equity_ticker, group in grouped:
        if pd.isna(equity_ticker):
            continue

        # One universe per equity ticker
        issuer_universe = (
            bq.univ.bonds([equity_ticker])
            .filter(
                (bq.data.crncy() == "eur")
                .and_(bq.data.maturity_years() > Min_Maturity_choose)
                .and_(bq.data.maturity_years() < Max_Maturity_choose)
                .and_(bq.data.amt_outstanding()/1000000 > Min_Amt_out_choose)
                .and_(bq.data.amt_outstanding()/1000000 < Max_Amt_out_choose)
                .and_(bq.data.spread(spread_type='Z') > 0)
            )
        )

        # Multiple regressions for different call dates of the same issuer
        data_items_issuer = {}
        idx_mapping = {}  # Map regression keys to original indices

        for i, (original_idx, row) in enumerate(group.iterrows()):
            call_date_years = row['Next Call Date (years)']
            if not pd.isna(call_date_years):
                regression_key = f"regression_{i}"  # Use simple counter
                data_items_issuer[regression_key] = bq.data.regression(
                    reg_by=bq.data.maturity_years().group(),
                    reg_value=bq.data.spread(st='z').group(),
                    regression_points=call_date_years,
                    regression_type=regression_type_choose
                )
                idx_mapping[regression_key] = original_idx  # Map back to original index

        if data_items_issuer:
            try:
                request = bql.Request(issuer_universe, data_items_issuer)
                response = bq.execute(request)

                # Store results using the mapping
                for data_item in response:
                    regression_key = data_item.name
                    if regression_key in idx_mapping:
                        df_result = data_item.df()
                        if not df_result.empty:
                            original_idx = idx_mapping[regression_key]
                            all_regression_results[original_idx] = df_result[regression_key].iloc[0]

            except Exception as e:
                print(f"Error processing {equity_ticker}")

    # Map results back to dataframe
    results_df['Interpolated Senior Spread'] = results_df.index.map(all_regression_results)
    results_df['Sub to Senior Spread'] = results_df['Z-Spread'] - results_df['Interpolated Senior Spread']


    return results_df
