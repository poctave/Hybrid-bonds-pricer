def filter_df(df):
    """Filters the DataFrame based on the set dropdown filters, now supporting
    multiple selections."""

    # Ensure Next Call Year column exists
    if 'Next Call Year' not in df.columns:
        df['Next Call Year'] = df['Next Call Date'].dt.year

    # Iterate over the dropdowns and corresponding columns
    dropdown_info = [
        (moody_dropdown, 'Moody Rating'),
        (sp_dropdown, 'S&P Rating'),
        (fitch_dropdown, 'Fitch Rating'),
        (company_dropdown, 'Company Name'),
        (sector_dropdown, 'Sector'),
        (next_call_year_dropdown, 'Next Call Year')
    ]

    filtered_df = df.copy() # Create a copy to filter

    for dropdown, col in dropdown_info:
        selected_values = dropdown.value

        # If nothing is selected in a SelectMultiple dropdown, don't filter by this column
        if selected_values:
            if col == 'Next Call Year':
                 # Ensure comparison with integer years
                 filtered_df = filtered_df[filtered_df[col].isin([int(val) for val in selected_values])]
            elif col in ['Moody Rating', 'S&P Rating']:
                 # Handle potential NaN values in ratings during filtering
                 filtered_df = filtered_df[filtered_df[col].isin(selected_values)]
            else:
                filtered_df = filtered_df[filtered_df[col].isin(selected_values)]


    return filtered_df
