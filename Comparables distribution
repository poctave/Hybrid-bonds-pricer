    timestamp = pd.Timestamp.now(tz='Europe/Berlin')
    date_today = timestamp.strftime('%Y-%m-%d_%H-%M-%S')
    file_name = f'Hybrids_Monitor_{date_today}.xlsx'

    # Export to Excel
    # CHANGE: Use the filtered df, not original_data
    df.to_excel(file_name, index=True)

    def create_download_link(filename):
        """Create a download link for a file"""
        with open(filename, "rb") as f:
            data = f.read()
        b64 = base64.b64encode(data).decode()
        # CHANGE: Use the original file name for download
        href = f'<a href="data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{b64}" download="{os.path.basename(filename)}"> Download {os.path.basename(filename)}</a>'
        return href

    # Display new download link directly
    display(HTML(create_download_link(file_name)))
