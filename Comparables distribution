def plot_sss_distribution_plotly(df):
    """Create an interactive histogram+KDE of the `Sub to Senior Spread` and display it."""

    # Check if the required column exists
    if 'Sub to Senior Spread' not in df.columns:
        print("DataFrame does not contain a column named 'Sub to Senior Spread'")
        return

    # Filter NaNs
    sss_data = df['Sub to Senior Spread'].dropna()

    # Check if we have data to plot
    if len(sss_data) == 0:
        print("No valid data to plot")
        return

    # Create the plot
    fig = px.histogram(
        df.dropna(subset=['Sub to Senior Spread']),
        x="Sub to Senior Spread",
        nbins=min(70, len(sss_data)//2) if len(sss_data) > 10 else 10,
        histnorm="density",
        opacity=0.75,
        marginal="violin",
        labels={"Sub to Senior Spread": "Sub to Senior Spread", "density": "Density"},
        color_discrete_sequence=["#FB8B1E"],
    )

    # Calculate statistics (Mean and Standard Deviation)
    mean_val = sss_data.mean()
    std_val = sss_data.std()

    # Add mean line
    fig.add_vline(
        x=mean_val,
        line_dash="dash",
        line_color="white",
        line_width=0.5,
        annotation_text=f"Mean: {mean_val:.0f}",
        annotation_position="top",
        row=1, col=1  # Specify main plot only
    )

    # Add standard deviation lines
    std_lines = [
        (-3, "red", "dash", f"-3σ: {mean_val - 3*std_val:.0f}"),
        (-2, "red", "dash", f"-2σ: {mean_val - 2*std_val:.0f}"),
        (-1, "red", "dash", f"-1σ: {mean_val - 1*std_val:.0f}"),
        (1, "red", "dash", f"+1σ: {mean_val + 1*std_val:.0f}"),
        (2, "red", "dash", f"+2σ: {mean_val + 2*std_val:.0f}"),
        (3, "red", "dash", f"+3σ: {mean_val + 3*std_val:.0f}")
    ]

    for std_mult, color, dash_style, label in std_lines:
        x_pos = mean_val + std_mult * std_val
        fig.add_vline(
            x=x_pos,
            line_dash=dash_style,
            line_color=color,
            line_width=0.5,
            annotation_text=label,
            row=1, col=1  # Specify main plot only
        )

    fig.update_layout(
        template='plotly_dark',
        plot_bgcolor='rgb(33,33,33)',
        paper_bgcolor='rgb(33,33,33)',
        margin=dict(l=20, r=20, t=50, b=20),
        hovermode="x unified",
        hoverlabel=dict(bgcolor='rgba(88,88,88,0.7)'),
        height=400,
        showlegend=False
    )

    # Display the figure within the plot_output widget
    with plot_output:
        clear_output(wait=True)
        display(fig)
def detach_handlers(widgets):
    """Detaches listeners from each of the dropdown widgets."""
    for widget in widgets:
        widget.unobserve(None, 'value')

def attach_handlers(widgets, df):
    """Attaches listeners to each of the dropdown widgets, passing in the
    hybrid bond DataFrame."""
    for widget in widgets:
        widget.observe(partial(update_display, df), 'value')
def update_display(df, event=None):
    """Updates the displayed DataFrames with new and filtered data."""
    # Apply filters based on the dropdown widgets
    filtered_df = filter_df(df) # Use the updated filter_df

    # Output the member data
    output_df(filtered_df) # Pass the filtered df

    # Output the summary
    output_summary(filtered_df) # Pass the filtered df

    # Update the plot with filtered data
    plot_sss_distribution_plotly(filtered_df) # Pass the filtered df
