def get_historical_data(input_ticker, lookback_days=15, zscore_rolling_days=15, regression_type='nelson_siegel_svenson'):
    """Retrieves historical SSS data for a specific ticker using execute_many for better performance."""

    # Fix date range to avoid future dates
    end_date = pd.Timestamp.today().normalize()
    start_date = end_date - pd.Timedelta(days=lookback_days)

    # Generate business days only (exclude weekends)
    date_list = pd.bdate_range(start=start_date, end=end_date)

    # First, get the hybrid bonds to determine call dates (current data only)
    univ_hybrid = (
        bq.univ.bonds(input_ticker)
        .filter(
            (bq.data.crncy() == "eur")
            .and_(bq.data.hybrid() == 'true')
            .and_(bq.data.amt_outstanding() > '400m')
        )
    )

    fields_hybrid = [
        bq.data.name(),
        bq.data.issue_dt(),
        bq.data.nxt_call_dt(),
        bq.data.cast_parent_equity_ticker(),
        bq.data.spread(spread_type='Z')
    ]

    # Get current hybrid bond info to determine structure
    try:
        request_hybrid_current = bql.Request(univ_hybrid, fields_hybrid)
        response_hybrid_current = bq.execute(request_hybrid_current)
        results_hybrid_current = [resp.df() for resp in response_hybrid_current]
        results_hybrid = pd.concat(results_hybrid_current, axis=1)
        results_hybrid.columns = ["NAME", "ISSUE DT", "NXT CALL DT", "ISSUER", "Z-Spread Date", "Z-Spread"]

        # Calculate call date in years
        results_hybrid["NXT CALL DT (Year)"] = (
            (results_hybrid["NXT CALL DT"] - pd.Timestamp.today()).dt.days / 365.25
        )

        if len(results_hybrid) == 0:
            print("No hybrid bonds found for this ticker")
            return pd.DataFrame(), pd.DataFrame()

    except Exception as e:
        print(f"Error fetching hybrid bond info: {e}")
        return pd.DataFrame(), pd.DataFrame()

    # Create request functions for execute_many
    def get_regression_request(ticker, date_str):
        univ_senior = (
            bq.univ.bonds(ticker)
            .filter(
                (bq.data.crncy() == "eur")
                .and_(bq.data.maturity() < '30y')
                .and_(bq.data.amt_outstanding() > '400m')
            )
        )

        fields_regression = {}
        for i, tenor in enumerate(results_hybrid["NXT CALL DT (Year)"]):
            if pd.notna(tenor) and tenor > 0:  # Only valid tenors
                fields_regression[f"regression_{i}"] = bq.data.regression(
                    reg_by=bq.data.maturity_years().group(),
                    reg_value=bq.data.spread(st='z').group(),
                    regression_points=tenor,
                    regression_type=regression_type
                )

        if not fields_regression:
            return None

        return bql.Request(univ_senior, fields_regression, with_params={'dates': date_str, 'fill':'prev'})

    def get_hybrid_request(ticker, date_str):
        return bql.Request(univ_hybrid, fields_hybrid, with_params={'dates': date_str, 'fill':'prev'})

    # Generate all requests
    regression_requests = []
    hybrid_requests = []
    valid_dates = []

    for dt in date_list:
        date_str = dt.strftime('%Y-%m-%d')

        reg_req = get_regression_request(input_ticker, date_str)
        hyb_req = get_hybrid_request(input_ticker, date_str)

        if reg_req is not None:
            regression_requests.append(reg_req)
            hybrid_requests.append(hyb_req)
            valid_dates.append(dt)

    if not regression_requests:
        print("No valid requests generated")
        return pd.DataFrame(), results_hybrid

    try:
        regression_responses = list(bq.execute_many(regression_requests))
        hybrid_responses = list(bq.execute_many(hybrid_requests))
    except Exception as e:
        print(f"Error executing BQL requests: {e}")
        return pd.DataFrame(), results_hybrid

    # Process all responses
    all_results = []

    for i, (reg_res, hyb_res, date_dt) in enumerate(zip(regression_responses, hybrid_responses, valid_dates)):
        date_str = date_dt.strftime('%Y-%m-%d')

        try:
            # Process regression results with error handling
            try:
                reg_dfs = [r.df() for r in reg_res if not r.df().empty]
                if not reg_dfs:
                    continue
                reg_df = pd.concat(reg_dfs, axis=1)
            except Exception as e:
                print(f"Error processing regression data for {date_str}: {e}")
                continue

            # Process hybrid results with error handling
            try:
                hyb_dfs = [r.df() for r in hyb_res if not r.df().empty]
                if not hyb_dfs:
                    continue
                hyb_df = pd.concat(hyb_dfs, axis=1)
            except Exception as e:
                print(f"Error processing hybrid data for {date_str}: {e}")
                continue

            # Calculate SSS for each bond
            z_spread_perp_list = []
            z_spread_senior_list = []
            sss_list = []
            bond_names = []

            for j in range(len(results_hybrid)):
                try:
                    # Check if we have data for this bond
                    if j >= len(hyb_df) or f"regression_{j}" not in reg_df.columns:
                        continue

                    # Get hybrid spread - try different column positions
                    z_spread_perp = None
                    for col_idx in [5, 4, 3, -1]:  # Try different positions for spread column, added 5
                        try:
                            if col_idx < hyb_df.shape[1]:
                                z_spread_perp = pd.to_numeric(hyb_df.iloc[j, col_idx], errors='coerce')
                                if pd.notna(z_spread_perp):
                                    break
                        except (IndexError, ValueError):
                            continue

                    # Get interpolated senior spread
                    z_spread_senior = pd.to_numeric(reg_df[f"regression_{j}"].iloc[0], errors='coerce')

                    # Only calculate SSS if both values are valid numbers
                    if (pd.notna(z_spread_perp) and pd.notna(z_spread_senior) and
                        isinstance(z_spread_perp, (int, float)) and isinstance(z_spread_senior, (int, float))):

                        sss = float(z_spread_perp) - float(z_spread_senior)

                        z_spread_perp_list.append(float(z_spread_perp))
                        z_spread_senior_list.append(float(z_spread_senior))
                        sss_list.append(sss)
                        bond_names.append(str(results_hybrid["NAME"].iloc[j]))

                except Exception as e:
                    print(f"Error processing bond {j} on {date_str}: {e}")
                    continue

            # Only add data if we have valid calculations
            if bond_names and len(bond_names) > 0:
                df_day = pd.DataFrame({
                    'bond_name': bond_names,
                    'z-spread perp': z_spread_perp_list,
                    'z-spread senior': z_spread_senior_list,
                    'SSS': sss_list,
                    'date': date_str
                })
                all_results.append(df_day)

        except Exception as e:
            print(f"Error processing {date_str}: {e}")
            continue

    if not all_results:
        print("No valid data retrieved")
        return pd.DataFrame(), results_hybrid

    try:
        # Combine and reshape data
        combined_df = pd.concat(all_results, ignore_index=True)
        combined_df = combined_df.drop_duplicates(subset=['date', 'bond_name'], keep='last')

        # Reshape to time series format
        final_df = combined_df.set_index(['date', 'bond_name']).unstack('bond_name')
        final_df.columns = [f"{bond}_{metric}" for metric, bond in final_df.columns]

        # Convert index to datetime
        final_df.index = pd.to_datetime(final_df.index)

        # Sort by date
        final_df = final_df.sort_index()

        # Clean outliers
        final_df_clean, cleaning_report = clean_z_spreads_by_change(final_df, max_daily_change=500, max_fill_days=10)

        # Calculate z-scores
        final_df_clean = calculate_zscores(final_df_clean, zscore_rolling_days)

        return final_df_clean, results_hybrid

    except Exception as e:
        print(f"Error in final data processing: {e}")
        return pd.DataFrame(), results_hybrid
def clean_z_spreads_by_change(df, max_daily_change=60, max_fill_days=10):
    """Clean z-spread columns by replacing extreme daily changes."""
    df_clean = df.copy()
    z_spread_cols = [col for col in df_clean.columns]
    cleaning_report = {}

    for col in z_spread_cols:
        daily_change = df_clean[col].diff().abs()
        change_outliers = daily_change > max_daily_change
        original_outliers = change_outliers.sum()

        df_clean.loc[change_outliers, col] = np.nan
        df_clean[col] = df_clean[col].fillna(method='ffill', limit=max_fill_days)

        remaining_nan = df_clean[col].isna().sum()
        cleaning_report[col] = {
            'large_changes_found': original_outliers,
            'changes_filled': original_outliers - remaining_nan,
            'remaining_nan': remaining_nan
        }

    return df_clean, cleaning_report
def calculate_zscores(df, zscore_rolling_days):
    """Calculate rolling z-scores for SSS columns."""
    sss_columns = [col for col in df.columns if col.endswith('_SSS')]

    for sss_col in sss_columns:
        z_col = sss_col.replace('_SSS', '_Z')
        roll_mean = df[sss_col].rolling(zscore_rolling_days, min_periods=3).mean()
        roll_std = df[sss_col].rolling(zscore_rolling_days, min_periods=3).std(ddof=0)

        df[z_col] = (df[sss_col] - roll_mean) / roll_std.replace(0, np.nan)
        df[z_col] = df[z_col].fillna(0)

    return df
def output_summary_table(df, ticker_name, bond_info):
