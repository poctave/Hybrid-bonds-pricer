            summary_data = []

            for sss_col in sss_columns:
                bond_name = sss_col.replace('_SSS', '')
                z_col = sss_col.replace('_SSS', '_Z')
                latest_sss = df[sss_col].iloc[-1] if not df[sss_col].isna().all() else np.nan
                latest_zscore = df[z_col].iloc[-1] if z_col in df.columns and not df[z_col].isna().all() else np.nan
                mean_sss = df[sss_col].mean()
